<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../css/menu_estoque.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.manutencao.TelaAgendaController">

    <BorderPane style="-fx-background-color: #F8FAFC;">
        <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <padding> <Insets bottom="10" left="15" right="15" top="10" /> </padding>
                <children>
                    <Button mnemonicParsing="false" onAction="#handleVoltar" styleClass="botao-voltar" text="←" />
                    <Label styleClass="logo-label" text="AGENDA DE MANUTENÇÃO" />
                </children>
            </HBox>
        </top>

        <center>
            <VBox spacing="20.0" styleClass="painel-central">
                <padding> <Insets bottom="30" left="30" right="30" top="30" /> </padding>
                <children>

                    <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Novo Agendamento:" />

                            <VBox spacing="5">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="DATA PREVISTA" />
                                <DatePicker fx:id="dpData" prefWidth="150.0" />
                            </VBox>

                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="DESCRIÇÃO (Ex: Troca de Correia HP400)" />
                                <TextField fx:id="txtDescricao" promptText="O que será feito?" HBox.hgrow="ALWAYS" style="-fx-pref-height: 30;" />
                            </VBox>

                            <Button onAction="#handleAdd" styleClass="botao-salvar" text="+ Adicionar" style="-fx-pref-height: 30;" />
                        </children>
                    </HBox>

                    <VBox VBox.vgrow="ALWAYS" spacing="10">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Próximas Manutenções Agendadas" />

                        <TableView fx:id="tabelaAgenda" VBox.vgrow="ALWAYS" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                            <columns>
                                <TableColumn fx:id="colData" prefWidth="120.0" text="Data Prevista" style="-fx-alignment: CENTER;" />
                                <TableColumn fx:id="colDescricao" prefWidth="500.0" text="Descrição do Serviço" />
                                <TableColumn fx:id="colAcao" prefWidth="120.0" text="Ação" style="-fx-alignment: CENTER;" />
                            </columns>
                            <columnResizePolicy> <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /> </columnResizePolicy>
                        </TableView>
                    </VBox>

                </children>
            </VBox>
        </center>
    </BorderPane>
</StackPane>