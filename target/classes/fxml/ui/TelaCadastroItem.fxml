<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="600.0" styleClass="root" stylesheets="@../ui/css/menu_estoque.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.CadastroItemController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets bottom="10" left="15" right="15" top="10" />
            </padding>
            <children>
                <Label styleClass="logo-label" text="CADASTRAR / EDITAR ITEM" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" styleClass="painel-central">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20" />
            </padding>
            <children>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" /> <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" /> <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="120.0" /> </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <children>
                        <Label styleClass="label-form" text="Selecione Partição:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cbParticao" maxWidth="1.7976931348623157E308" promptText="Escolha a partição..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="label-form" text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNome" promptText="Ex: Parafuso Hexagonal" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="label-form" text="Estoque:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="txtEstoque" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label styleClass="label-form" text="Especificação:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtEspecificacao" promptText="Ex: Aço Inox 10mm" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <VBox alignment="TOP_CENTER" spacing="5" GridPane.columnIndex="2" GridPane.rowSpan="4">
                            <VBox alignment="CENTER" maxHeight="120" maxWidth="120" minHeight="120" minWidth="120" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
                                <ImageView fx:id="imgPreview" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
                            </VBox>
                            <Button fx:id="btnSelecionarFoto" onAction="#handleSelecionarFoto" styleClass="botao-simples" text="Selecionar Foto" />
                        </VBox>
                    </children>
                </GridPane>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <children>
                        <Label styleClass="label-form" text="Local Armaz.:" GridPane.rowIndex="0" />
                        <TextField fx:id="txtLocalArmaz" promptText="Ex: Prateleira B3" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="label-form" text="Local de Aplic.:" GridPane.rowIndex="1" />
                        <TextField fx:id="txtLocalAplic" promptText="Ex: Setor de Montagem" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="label-form" text="Descrição:" GridPane.rowIndex="2" GridPane.valignment="TOP">
                            <GridPane.margin>
                                <Insets top="5.0" />
                            </GridPane.margin>
                        </Label>
                        <TextArea fx:id="txtDescricao" prefHeight="80.0" promptText="Detalhes adicionais do item..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="40.0" styleClass="rodape">
            <padding>
                <Insets bottom="15" top="15" />
            </padding>
            <children>
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#handleCancelar" styleClass="botao-cancelar" text="✖ Cancelar" />

                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvar" styleClass="botao-salvar" text="✔ Salvar" />
            </children>
        </HBox>
    </bottom>

</BorderPane>