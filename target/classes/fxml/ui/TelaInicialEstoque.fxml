<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../ui/css/menu_estoque.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.TelaInicialEstoqueController">

    <BorderPane style="-fx-background-color: #F8FAFC;">
        <top>
            <HBox styleClass="top-bar">
                <children>
                    <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#handleVoltar" styleClass="botao-voltar" text="←" />
                    <Label styleClass="logo-label" text="ESTOQUE" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnCadastrarItem" mnemonicParsing="false" onAction="#handleCadastrarItem" styleClass="botao-top" text="+ Novo Item" />
                    <Button fx:id="btnCadastrarParticao" mnemonicParsing="false" onAction="#handleCadastrarParticao" styleClass="botao-top" text="+ Nova Partição" />
                    <Button fx:id="btnFechar" mnemonicParsing="false" onAction="#handleFechar" styleClass="botao-fechar" text="✕" />
                </children>
            </HBox>
        </top>

        <left>
            <VBox prefWidth="380.0" styleClass="sidebar" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 2, 0);">
                <children>
                    <Label styleClass="sidebar-titulo" text="Partições e Itens">
                        <VBox.margin>
                            <Insets bottom="10.0" left="20.0" top="20.0" />
                        </VBox.margin>
                    </Label>
                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="vboxParticoes" spacing="10.0">
                                <padding>
                                    <Insets bottom="10.0" left="15.0" right="15.0" top="5.0" />
                                </padding>
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
            </VBox>
        </left>

        <center>
            <VBox alignment="TOP_CENTER" styleClass="painel-central" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="40" left="40" right="40" top="40" />
                </padding>
                <children>

                    <VBox fx:id="paneDetalhes" spacing="20" styleClass="card-detalhes" visible="false">
                        <children>
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lblNomeItem" styleClass="titulo-card" text="Nome do Item Selecionado" />
                            </HBox>

                            <HBox spacing="40.0" VBox.vgrow="ALWAYS">
                                <children>
                                    <GridPane hgap="15" vgap="15" HBox.hgrow="ALWAYS">
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="NEVER" minWidth="140.0" prefWidth="150.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <children>
                                            <Label styleClass="campo-titulo" text="ESTOQUE ATUAL:" GridPane.rowIndex="0" GridPane.valignment="TOP" />
                                            <Label fx:id="lblEstoqueItem" styleClass="campo-valor" text="00" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.valignment="TOP" />

                                            <Label styleClass="campo-titulo" text="ESPECIFICAÇÃO:" GridPane.rowIndex="1" GridPane.valignment="TOP" />
                                            <Label fx:id="lblEspecificacaoItem" styleClass="campo-valor" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.valignment="TOP" />

                                            <Label styleClass="campo-titulo" text="LOCAL APLICAÇÃO:" GridPane.rowIndex="2" GridPane.valignment="TOP" />
                                            <Label fx:id="lblLocalItem" styleClass="campo-valor" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.valignment="TOP" />

                                            <Label styleClass="campo-titulo" text="LOCAL ARMAZEN.:" GridPane.rowIndex="3" GridPane.valignment="TOP" />
                                            <Label fx:id="lblLocalArmazenamento" styleClass="campo-valor" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.valignment="TOP" />

                                            <Label styleClass="campo-titulo" text="DATA CADASTRO:" GridPane.rowIndex="4" GridPane.valignment="TOP" />
                                            <Label fx:id="lblDataItem" styleClass="campo-valor" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.valignment="TOP" />

                                            <Label styleClass="campo-titulo" text="DESCRIÇÃO:" GridPane.rowIndex="5" GridPane.valignment="TOP" />
                                            <Label fx:id="lblDescricaoItem" styleClass="campo-valor" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.valignment="TOP" />
                                        </children>
                                        <rowConstraints>
                                            <RowConstraints vgrow="NEVER" />
                                            <RowConstraints vgrow="NEVER" />
                                            <RowConstraints vgrow="NEVER" />
                                            <RowConstraints vgrow="NEVER" />
                                            <RowConstraints vgrow="NEVER" />
                                            <RowConstraints vgrow="ALWAYS" /> </rowConstraints>
                                    </GridPane>
                                    <VBox alignment="TOP_CENTER" minWidth="220" spacing="10">
                                        <Label styleClass="label-foto-titulo" text="IMAGEM DO ITEM" />
                                        <VBox alignment="CENTER" maxHeight="200" maxWidth="200" minHeight="200" minWidth="200" styleClass="foto-frame">
                                            <ImageView fx:id="imgFotoItem" fitHeight="190.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true" />
                                        </VBox>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <Label fx:id="lblMensagemVazia" styleClass="label-vazio" text="Selecione um item na lista para ver os detalhes." VBox.vgrow="ALWAYS" />
                </children>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="20.0" styleClass="rodape" BorderPane.alignment="CENTER">
                <padding>
                    <Insets right="30.0" />
                </padding>
                <children>
                    <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#handleEditar" styleClass="botao-menu" text="Editar" />
                    <Button fx:id="btnRegistros" mnemonicParsing="false" onAction="#handleRegistros" styleClass="botao-menu" text="Ver Registros" />
                </children>
            </HBox>
        </bottom>
    </BorderPane>
</StackPane>