<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@../css/menu_estoque.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.manutencao.HistoricoManutencaoController">

    <BorderPane style="-fx-background-color: #F8FAFC;">
        <top>
            <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                <padding>
                    <Insets bottom="10" left="15" right="15" top="10" />
                </padding>
                <children>
                    <Button mnemonicParsing="false" onAction="#handleVoltar" styleClass="botao-voltar" text="←" />
                    <Label styleClass="logo-label" text="HISTÓRICO GERAL DE MANUTENÇÃO" />
                </children>
            </HBox>
        </top>

        <center>
            <VBox spacing="20.0" styleClass="painel-central">
                <padding>
                    <Insets bottom="30" left="40" right="40" top="30" />
                </padding>
                <children>

                    <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" text="FILTRAR POR:" />

                            <VBox spacing="5">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="EQUIPAMENTO" />
                                <ComboBox fx:id="cbFiltroEquipamento" prefWidth="180.0" promptText="Todos" />
                            </VBox>

                            <VBox spacing="5">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748B;" text="TIPO DE SERVIÇO" />
                                <ComboBox fx:id="cbFiltroTipo" prefWidth="220.0" promptText="Todos" />
                            </VBox>

                            <HBox HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleLimparFiltros" style="-fx-background-color: #E5E7EB; -fx-text-fill: #374151; -fx-cursor: hand; -fx-font-weight: bold;" text="Limpar Filtros" />
                        </children>
                    </HBox>

                    <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                        <columns>
                            <TableColumn fx:id="colData" prefWidth="120.0" style="-fx-alignment: CENTER;" text="DATA" />
                            <TableColumn fx:id="colEquipamento" prefWidth="150.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;" text="EQUIPAMENTO" />
                            <TableColumn fx:id="colTipo" prefWidth="200.0" text="TIPO DE SERVIÇO" />
                            <TableColumn fx:id="colEspecificacao" prefWidth="300.0" text="ESPECIFICAÇÃO / OBS" />
                            <TableColumn fx:id="colHorimetro" prefWidth="120.0" style="-fx-alignment: CENTER;" text="HORÍMETRO" />
                            <TableColumn fx:id="colResponsavel" prefWidth="150.0" text="RESPONSÁVEL" />
                            <TableColumn fx:id="colFiltro" prefWidth="80.0" style="-fx-alignment: CENTER;" text="FILTRO" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Nenhum registro encontrado." />
                        </placeholder>
                    </TableView>

                </children>
            </VBox>
        </center>
    </BorderPane>
</StackPane>