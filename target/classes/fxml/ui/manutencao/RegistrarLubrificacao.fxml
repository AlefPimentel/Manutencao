<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.manutencao.RegistrarLubrificacaoController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Lubrificar Linha Completa" />

    <VBox spacing="15.0" maxWidth="400">

        <HBox spacing="15">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Data:" />
                <DatePicker fx:id="dpData" maxWidth="Infinity" style="-fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
            </VBox>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Horímetro (Geral):" />
                <TextField fx:id="txtHorimetro" promptText="Ex: 12500" style="-fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
            </VBox>
        </HBox>

        <VBox spacing="5">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Responsável:" />
            <TextField fx:id="txtResponsavel" promptText="Nome do mecânico" style="-fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
        </VBox>

        <VBox spacing="5">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Tipo de Graxa / Observação:" />
            <TextField fx:id="txtGraxa" promptText="Ex: EP-2 Azul" style="-fx-border-color: #CBD5E1; -fx-border-radius: 4;" />
        </VBox>

    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
        <Button onAction="#handleCancelar" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;" text="Cancelar" />
        <Button onAction="#handleSalvar" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 8 20;" text="Salvar Registro" />
    </HBox>

</VBox>