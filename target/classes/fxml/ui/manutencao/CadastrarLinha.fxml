<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.manutencao.CadastrarLinhaController">
    <Label text="Nome da Nova Linha:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
    <TextField fx:id="txtNome" promptText="Ex: Linha de Britagem 04" />
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#handleCancelar" />
        <Button text="Salvar" onAction="#handleSalvar" style="-fx-background-color: #0078D4; -fx-text-fill: white;" />
    </HBox>
</VBox>