<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="350.0" prefWidth="450.0" styleClass="root" stylesheets="@../ui/css/menu_estoque.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.RetiradaItemController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding>
                <Insets bottom="10" left="15" right="15" top="10" />
            </padding>
            <children>
                <Label styleClass="logo-label" text="RETIRADA DE ESTOQUE" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0" styleClass="painel-central">
            <padding>
                <Insets bottom="30" left="40" right="40" top="30" />
            </padding>
            <children>
                <VBox style="-fx-background-color: #E0F2FE; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #BAE6FD; -fx-border-radius: 5;">
                    <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #0078D4; -fx-font-weight: bold;" text="ITEM SELECIONADO:" />
                        <Label fx:id="lblNomeItem" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Nome do Item" />
                        <HBox spacing="5">
                            <Label text="Disponível:" textFill="#6b7280" />
                            <Label fx:id="lblEstoqueAtual" style="-fx-font-weight: bold;" text="0" />
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="label-form" text="Quantidade a Retirar:" />
                    <TextField fx:id="txtQuantidade" promptText="Ex: 1" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="label-form" text="Responsável pela Retirada:" />
                    <TextField fx:id="txtResponsavel" promptText="Quem está levando?" />
                </VBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="rodape">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancelar" styleClass="botao-cancelar" text="Cancelar" />
                <Button defaultButton="true" mnemonicParsing="false" onAction="#handleConfirmar" style="-fx-background-color: #DC2626;" styleClass="botao-salvar" text="Confirmar Retirada" />
            </children>
        </HBox>
    </bottom>

</BorderPane>